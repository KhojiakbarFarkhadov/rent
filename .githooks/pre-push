#!/bin/sh
# Rent — pre-push
# 1. progress.html ni sprints/ papkasidan qaytadan yasaydi
# 2. Bajarilgan taski bor-u hisoboti yo'q sprintlarni sanab beradi
# Hech qachon to'xtatmaydi — faqat ogohlantiradi.

ILDIZ=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ILDIZ" || exit 0

command -v node >/dev/null 2>&1 || exit 0
[ -f scripts/progress.js ] || exit 0

node scripts/progress.js --ogoh 2>&1 | sed 's/^/hisobotchi: /'

# progress.html commit qilinmagan bo'lsa — eslat
if ! git diff --quiet -- progress.html 2>/dev/null; then
  echo "hisobotchi: progress.html yangilandi, lekin commit qilinmagan."
  echo "hisobotchi: git add progress.html && git commit --amend --no-edit"
fi

exit 0
